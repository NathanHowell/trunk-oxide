# trunk-whisperer: standalone gRPC speech-to-text service
# whisper-rs statically links whisper.cpp — the binary is self-contained

FROM rust:trixie AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake \
    libclang-dev \
    libprotobuf-dev \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy workspace manifests and lockfile first for dependency caching
COPY Cargo.toml Cargo.lock ./
COPY crates/trunk-whisperer/Cargo.toml crates/trunk-whisperer/Cargo.toml
COPY crates/trunk-whisperer/build.rs crates/trunk-whisperer/build.rs
COPY crates/trunk-whisperer/proto crates/trunk-whisperer/proto

# Stub workspace members that trunk-whisperer doesn't depend on
COPY crates/trunk-oxide-grpc/Cargo.toml crates/trunk-oxide-grpc/Cargo.toml
COPY crates/trunk-oxide-proto/Cargo.toml crates/trunk-oxide-proto/Cargo.toml
COPY crates/trunk-recorder-plugin/Cargo.toml crates/trunk-recorder-plugin/Cargo.toml
COPY crates/trunk-recorder-sys/Cargo.toml crates/trunk-recorder-sys/Cargo.toml
COPY crates/trunk-discord/Cargo.toml crates/trunk-discord/Cargo.toml
COPY crates/trunk-oxide-driver/Cargo.toml crates/trunk-oxide-driver/Cargo.toml

# Create stub sources so cargo can resolve the workspace and cache dependencies
RUN mkdir -p crates/trunk-whisperer/src \
    && echo "fn main() {}" > crates/trunk-whisperer/src/main.rs \
    && mkdir -p crates/trunk-oxide-grpc/src \
    && echo "" > crates/trunk-oxide-grpc/src/lib.rs \
    && mkdir -p crates/trunk-oxide-proto/src \
    && echo "" > crates/trunk-oxide-proto/src/lib.rs \
    && mkdir -p crates/trunk-recorder-plugin/src \
    && echo "" > crates/trunk-recorder-plugin/src/lib.rs \
    && mkdir -p crates/trunk-recorder-sys/src \
    && echo "" > crates/trunk-recorder-sys/src/lib.rs \
    && mkdir -p crates/trunk-discord/src \
    && echo "fn main() {}" > crates/trunk-discord/src/main.rs \
    && mkdir -p crates/trunk-oxide-driver/src \
    && echo "" > crates/trunk-oxide-driver/src/lib.rs

RUN cargo build --release -p trunk-whisperer || true

# Copy real sources and rebuild
COPY crates/trunk-whisperer/src crates/trunk-whisperer/src

# Touch sources to invalidate the stub build artifacts
RUN touch crates/trunk-whisperer/src/main.rs

RUN cargo build --release -p trunk-whisperer

# Runtime — distroless for minimal attack surface
FROM ghcr.io/grpc-ecosystem/grpc-health-probe:v0.4.45 AS health-probe

FROM gcr.io/distroless/cc-debian13:nonroot

COPY --from=health-probe /ko-app/grpc-health-probe /bin/grpc_health_probe
COPY --from=builder /build/target/release/trunk-whisperer /bin/trunk-whisperer

ENTRYPOINT ["/bin/trunk-whisperer"]
