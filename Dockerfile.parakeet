# trunk-parakeet: standalone gRPC speech-to-text service (NVIDIA Parakeet ASR)
# Drop-in replacement for trunk-whisperer — serves the same Transcriber gRPC
# service on the same Unix socket. Swap the container, leave trunk-discord's
# config unchanged.
#
# parakeet-rs runs ONNX Runtime via the `ort` crate. `ort`'s default
# `download-binaries` feature fetches a prebuilt ONNX Runtime at build time and
# links it statically, so the runtime image stays distroless (self-contained
# binary, no libonnxruntime.so to ship).
#
# Requires BuildKit (default in modern Docker / `docker buildx`). Cargo's
# registry, git, and target dirs are persisted across builds via cache mounts,
# so only changed crates recompile — no per-crate stub scaffolding needed.

FROM rust:trixie AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake \
    libclang-dev \
    libprotobuf-dev \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY . .

RUN --mount=type=cache,target=/usr/local/cargo/registry,id=cargo-registry \
    --mount=type=cache,target=/usr/local/cargo/git,id=cargo-git \
    --mount=type=cache,target=/build/target,id=target-parakeet \
    cargo build --release -p trunk-parakeet \
    && cp target/release/trunk-parakeet /usr/local/bin/trunk-parakeet

# Runtime — distroless for minimal attack surface
FROM ghcr.io/grpc-ecosystem/grpc-health-probe:v0.4.45 AS health-probe

FROM gcr.io/distroless/cc-debian13:nonroot

COPY --from=health-probe /ko-app/grpc-health-probe /usr/local/bin/grpc_health_probe
COPY --from=builder /usr/local/bin/trunk-parakeet /usr/local/bin/trunk-parakeet

ENTRYPOINT ["/usr/local/bin/trunk-parakeet"]
