# trunk-oxide: links libtrunk-recorder.so and drives it via FFI.
# Building both from the same base avoids glibc/ABI mismatches.

FROM rust:trixie AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    gnuradio-dev \
    gr-osmosdr \
    libairspy-dev \
    libairspyhf-dev \
    libbladerf-dev \
    libboost-all-dev \
    libgmp-dev \
    liborc-0.4-dev \
    libosmosdr-dev \
    libpthread-stubs0-dev \
    librtlsdr-dev \
    libsoapysdr-dev \
    libuhd-dev \
    libusb-dev \
    libusb-1.0-0-dev \
    libfmt-dev \
    mold \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# rust-lld does not support --require-defined; use mold for the final link
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUSTFLAGS="-Clink-arg=-fuse-ld=mold"
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_RUSTFLAGS="-Clink-arg=-fuse-ld=mold"

WORKDIR /build

# ── Build trunk-recorder as a shared library ──

COPY trunk-recorder trunk-recorder

RUN cmake -S trunk-recorder -B trunk-recorder/build \
        -DCMAKE_INSTALL_LIBDIR=lib \
    && cmake --build trunk-recorder/build -j2 --target trunk_recorder_shared \
    && cp trunk-recorder/build/libtrunk-recorder.so /usr/local/lib/ \
    && cp trunk-recorder/build/libgnuradio-op25_repeater.so /usr/local/lib/ \
    && ldconfig

# ── Build trunk-oxide binary ──

COPY Cargo.toml Cargo.lock ./

# Copy manifests, build scripts, and proto files for trunk-oxide and its deps
COPY crates/trunk-oxide/Cargo.toml crates/trunk-oxide/Cargo.toml
COPY crates/trunk-oxide-grpc/Cargo.toml crates/trunk-oxide-grpc/Cargo.toml
COPY crates/trunk-oxide-proto/Cargo.toml crates/trunk-oxide-proto/Cargo.toml
COPY crates/trunk-oxide-proto/build.rs crates/trunk-oxide-proto/build.rs
COPY crates/trunk-oxide-proto/proto crates/trunk-oxide-proto/proto
COPY crates/trunk-recorder-sys/Cargo.toml crates/trunk-recorder-sys/Cargo.toml
COPY crates/trunk-recorder-sys/build.rs crates/trunk-recorder-sys/build.rs
COPY crates/trunk-recorder-sys/cpp crates/trunk-recorder-sys/cpp
COPY crates/trunk-recorder-plugin/Cargo.toml crates/trunk-recorder-plugin/Cargo.toml

# Stub workspace members not needed for this build
COPY crates/trunk-whisperer/Cargo.toml crates/trunk-whisperer/Cargo.toml
COPY crates/trunk-discord/Cargo.toml crates/trunk-discord/Cargo.toml
COPY crates/trunk-solver/Cargo.toml crates/trunk-solver/Cargo.toml
COPY crates/trunk-database/Cargo.toml crates/trunk-database/Cargo.toml

# Create stub sources so cargo can resolve the workspace and cache dependencies
RUN mkdir -p crates/trunk-oxide/src \
    && echo "" > crates/trunk-oxide/src/lib.rs \
    && echo "fn main() {}" > crates/trunk-oxide/src/main.rs \
    && mkdir -p crates/trunk-oxide-grpc/src \
    && echo "" > crates/trunk-oxide-grpc/src/lib.rs \
    && mkdir -p crates/trunk-oxide-proto/src \
    && echo "" > crates/trunk-oxide-proto/src/lib.rs \
    && mkdir -p crates/trunk-recorder-sys/src \
    && echo "" > crates/trunk-recorder-sys/src/lib.rs \
    && mkdir -p crates/trunk-recorder-plugin/src \
    && echo "" > crates/trunk-recorder-plugin/src/lib.rs \
    && mkdir -p crates/trunk-whisperer/src \
    && echo "fn main() {}" > crates/trunk-whisperer/src/main.rs \
    && mkdir -p crates/trunk-discord/src \
    && echo "fn main() {}" > crates/trunk-discord/src/main.rs \
    && mkdir -p crates/trunk-solver/src \
    && echo "fn main() {}" > crates/trunk-solver/src/main.rs \
    && mkdir -p crates/trunk-database/src \
    && echo "" > crates/trunk-database/src/lib.rs

ENV TRUNK_RECORDER_LIB_DIR=/usr/local/lib

RUN cargo build --release -p trunk-oxide || true

COPY crates/trunk-recorder-sys/src crates/trunk-recorder-sys/src
COPY crates/trunk-recorder-plugin/src crates/trunk-recorder-plugin/src
COPY crates/trunk-oxide-proto/src crates/trunk-oxide-proto/src
COPY crates/trunk-oxide-grpc/src crates/trunk-oxide-grpc/src
COPY crates/trunk-oxide/src crates/trunk-oxide/src

RUN touch crates/trunk-recorder-sys/src/lib.rs \
    crates/trunk-recorder-plugin/src/lib.rs \
    crates/trunk-oxide-proto/src/lib.rs \
    crates/trunk-oxide-grpc/src/lib.rs \
    crates/trunk-oxide/src/lib.rs \
    crates/trunk-oxide/src/main.rs

RUN cargo build --release -p trunk-oxide

# ── Runtime ──

FROM ghcr.io/grpc-ecosystem/grpc-health-probe:v0.4.45 AS health-probe

FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    gnuradio \
    gr-osmosdr \
    libboost-log1.83.0 \
    libsoapysdr0.8 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=health-probe /ko-app/grpc-health-probe /usr/local/bin/grpc_health_probe
COPY --from=builder /usr/local /usr/local
COPY --from=builder /build/target/release/trunk-oxide /usr/local/bin/

RUN ldconfig

WORKDIR /app
ENV HOME=/tmp

CMD ["/usr/local/bin/trunk-oxide"]
