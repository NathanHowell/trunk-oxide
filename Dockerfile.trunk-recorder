# trunk-oxide: statically links trunk-recorder and drives it via FFI.
# Building both from the same base avoids glibc/ABI mismatches.
#
# Requires BuildKit (default in modern Docker / `docker buildx`). Cargo's
# registry, git, and target dirs (the latter also holds the C++ trunk-recorder
# build via build.rs) are persisted across builds via cache mounts, so only
# changed crates recompile — no per-crate stub scaffolding needed.

FROM rust:trixie AS builder

# Install gnuradio component libs (for linking) and build tools.
# gnuradio-dev is extracted manually below to avoid pulling in the gnuradio
# meta-package (which drags in Qt5, Qt6, PyQt, OpenMPI, python, etc.).
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    gr-osmosdr \
    libairspy-dev \
    libairspyhf-dev \
    libbladerf-dev \
    libboost-all-dev \
    libvolk-dev \
    libfmt-dev \
    libspdlog-dev \
    libgnuradio-analog3.10.12 \
    libgnuradio-audio3.10.12 \
    libgnuradio-blocks3.10.12 \
    libgnuradio-digital3.10.12 \
    libgnuradio-fft3.10.12 \
    libgnuradio-filter3.10.12 \
    libgnuradio-network3.10.12 \
    libgnuradio-pmt3.10.12 \
    libgnuradio-runtime3.10.12 \
    libgnuradio-uhd3.10.12 \
    libosmosdr-dev \
    librtlsdr-dev \
    libsoapysdr-dev \
    libuhd-dev \
    libusb-dev \
    libusb-1.0-0-dev \
    mold \
    pkg-config \
    libprotobuf-dev \
    protobuf-compiler \
    && apt-get download gnuradio-dev \
    && dpkg -x gnuradio-dev_*.deb / \
    && rm gnuradio-dev_*.deb \
    && rm -rf /var/lib/apt/lists/* \
    && ldconfig

# rust-lld does not support --require-defined; use mold for the final link
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUSTFLAGS="-Clink-arg=-fuse-ld=mold"
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_RUSTFLAGS="-Clink-arg=-fuse-ld=mold"

WORKDIR /build

COPY . .

RUN --mount=type=cache,target=/usr/local/cargo/registry,id=cargo-registry \
    --mount=type=cache,target=/usr/local/cargo/git,id=cargo-git \
    --mount=type=cache,target=/build/target,id=target-oxide \
    cargo build --release -p trunk-oxide \
    && cp target/release/trunk-oxide /usr/local/bin/trunk-oxide

# ── Runtime ──

FROM ghcr.io/grpc-ecosystem/grpc-health-probe:v0.4.45 AS health-probe

FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libboost-log1.83.0 \
    libgnuradio-analog3.10.12 \
    libgnuradio-audio3.10.12 \
    libgnuradio-blocks3.10.12 \
    libgnuradio-digital3.10.12 \
    libgnuradio-fft3.10.12 \
    libgnuradio-filter3.10.12 \
    libgnuradio-network3.10.12 \
    libgnuradio-pmt3.10.12 \
    libgnuradio-runtime3.10.12 \
    libgnuradio-uhd3.10.12 \
    libgnuradio-osmosdr0.2.0t64 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=health-probe /ko-app/grpc-health-probe /usr/local/bin/grpc_health_probe
COPY --from=builder /usr/local/bin/trunk-oxide /usr/local/bin/

WORKDIR /app
ENV HOME=/tmp

CMD ["/usr/local/bin/trunk-oxide"]
