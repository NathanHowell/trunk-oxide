# trunk-recorder + trunk-oxide-grpc plugin, built from source on Debian Trixie.
# Building both from the same base avoids glibc/ABI mismatches.

FROM rust:trixie AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    curl \
    gnuradio-dev \
    gr-osmosdr \
    libairspy-dev \
    libairspyhf-dev \
    libbladerf-dev \
    libboost-all-dev \
    libcurl4-openssl-dev \
    libgmp-dev \
    libhackrf-dev \
    liborc-0.4-dev \
    libosmosdr-dev \
    libprotobuf-dev \
    libpthread-stubs0-dev \
    librtlsdr-dev \
    libsndfile1-dev \
    libsoapysdr-dev \
    libssl-dev \
    libuhd-dev \
    libusb-dev \
    libusb-1.0-0-dev \
    mold \
    pkg-config \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# rust-lld does not support --require-defined; use mold for the final link
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUSTFLAGS="-Clink-arg=-fuse-ld=mold"
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_RUSTFLAGS="-Clink-arg=-fuse-ld=mold"

WORKDIR /build

# ── Build trunk-recorder from source ──

COPY trunk-recorder trunk-recorder

RUN cmake -S trunk-recorder -B trunk-recorder/build \
    && cmake --build trunk-recorder/build -j2 \
    && cmake --install trunk-recorder/build --prefix /usr/local

# ── Build trunk-oxide-grpc plugin ──

COPY Cargo.toml Cargo.lock ./
COPY crates/trunk-oxide-grpc/Cargo.toml crates/trunk-oxide-grpc/Cargo.toml
COPY crates/trunk-oxide-grpc/build.rs crates/trunk-oxide-grpc/build.rs
COPY crates/trunk-oxide-grpc/proto crates/trunk-oxide-grpc/proto
COPY crates/trunk-recorder-sys/Cargo.toml crates/trunk-recorder-sys/Cargo.toml
COPY crates/trunk-recorder-sys/build.rs crates/trunk-recorder-sys/build.rs
COPY crates/trunk-recorder-sys/cpp crates/trunk-recorder-sys/cpp
COPY crates/trunk-recorder-plugin/Cargo.toml crates/trunk-recorder-plugin/Cargo.toml
COPY crates/trunk-whisperer/Cargo.toml crates/trunk-whisperer/Cargo.toml

# Create stub sources so cargo can resolve the workspace and cache dependencies
RUN mkdir -p crates/trunk-oxide-grpc/src \
    && echo "" > crates/trunk-oxide-grpc/src/lib.rs \
    && mkdir -p crates/trunk-recorder-sys/src \
    && echo "" > crates/trunk-recorder-sys/src/lib.rs \
    && mkdir -p crates/trunk-recorder-plugin/src \
    && echo "" > crates/trunk-recorder-plugin/src/lib.rs \
    && mkdir -p crates/trunk-whisperer/src \
    && echo "fn main() {}" > crates/trunk-whisperer/src/main.rs

RUN cargo build --release -p trunk-oxide-grpc || true

COPY crates/trunk-recorder-sys/src crates/trunk-recorder-sys/src
COPY crates/trunk-recorder-plugin/src crates/trunk-recorder-plugin/src
COPY crates/trunk-oxide-grpc/src crates/trunk-oxide-grpc/src

RUN touch crates/trunk-recorder-sys/src/lib.rs \
    crates/trunk-recorder-plugin/src/lib.rs \
    crates/trunk-oxide-grpc/src/lib.rs

RUN cargo build --release -p trunk-oxide-grpc

RUN nm -D --defined-only target/release/libtrunk_oxide_grpc.so | grep -q create_plugin

# ── Runtime ──

FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    gnuradio \
    gr-osmosdr \
    libboost-log1.83.0 \
    libcurl4 \
    libsndfile1 \
    libsoapysdr0.8 \
    sox \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local /usr/local
COPY --from=builder /build/target/release/libtrunk_oxide_grpc.so /usr/local/lib/

RUN ldconfig

WORKDIR /app
ENV HOME=/tmp

CMD ["trunk-recorder", "--config=/app/config.json"]
