# trunk-oxide: the radio in Rust. librtlsdr is the only native library.
#
# Requires BuildKit (default in modern Docker / `docker buildx`). Cargo's
# registry, git, and target dirs are persisted across builds via cache mounts,
# so only changed crates recompile.

FROM rust:trixie AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    librtlsdr-dev \
    mold \
    pkg-config \
    libprotobuf-dev \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# The CPU this image runs on. `just build` resolves it to a name (znver3, ...)
# rather than `native`: cargo fingerprints the flag text, so a bare `native`
# would keep serving cached objects built for the previous CPU after a swap.
# These env vars replace .cargo/config.toml's rustflags, so it is stated here.
ARG TARGET_CPU=native
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUSTFLAGS="-Clink-arg=-fuse-ld=mold -Ctarget-cpu=${TARGET_CPU}"
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_RUSTFLAGS="-Clink-arg=-fuse-ld=mold -Ctarget-cpu=${TARGET_CPU}"

WORKDIR /build

COPY . .

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked,id=cargo-registry \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked,id=cargo-git \
    --mount=type=cache,target=/build/target,id=target-oxide \
    cargo build --release -p trunk-oxide \
    && cp target/release/trunk-oxide target/release/trunk-replay /usr/local/bin/

# ── Runtime ──

FROM ghcr.io/grpc-ecosystem/grpc-health-probe:v0.4.45 AS health-probe

FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    librtlsdr0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=health-probe /ko-app/grpc-health-probe /usr/local/bin/grpc_health_probe
COPY --from=builder /usr/local/bin/trunk-oxide /usr/local/bin/trunk-replay /usr/local/bin/

WORKDIR /app
ENV HOME=/tmp

CMD ["/usr/local/bin/trunk-oxide"]
